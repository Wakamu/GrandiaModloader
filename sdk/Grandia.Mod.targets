<Project>
  <!-- Assemble scripts/*.asm, embed maps/scripts bins, and embed assets/** (PNGs, …). -->
  <PropertyGroup>
    <GrandiaModloaderDir Condition="'$(GrandiaModloaderDir)' == ''">$(GRANDIA_MODLOADER)</GrandiaModloaderDir>
    <GrandiaModloaderDir Condition="'$(GrandiaModloaderDir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\GrandiaModloader', 'InstallDir', null, RegistryView.Registry32, RegistryView.Registry64))</GrandiaModloaderDir>
    <GrandiaModloaderDir Condition="'$(GrandiaModloaderDir)' == '' and Exists('C:\Program Files (x86)\Grandia Modloader\Grandia.Sdk.dll')">C:\Program Files (x86)\Grandia Modloader</GrandiaModloaderDir>
    <GrandiaModloaderDir Condition="'$(GrandiaModloaderDir)' == '' and Exists('C:\Program Files\Grandia Modloader\Grandia.Sdk.dll')">C:\Program Files\Grandia Modloader</GrandiaModloaderDir>
    <GrandiaModloaderDir Condition="'$(GrandiaModloaderDir)' == '' and Exists('$(MSBuildThisFileDirectory)Grandia.Sdk.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</GrandiaModloaderDir>
    <GrandiaSdkDll Condition="'$(GrandiaSdkDll)' == '' and Exists('$(GrandiaModloaderDir)\Grandia.Sdk.dll')">$(GrandiaModloaderDir)\Grandia.Sdk.dll</GrandiaSdkDll>
    <GrandiaSdkDll Condition="'$(GrandiaSdkDll)' == '' and Exists('$(MSBuildThisFileDirectory)Grandia.Sdk.dll')">$(MSBuildThisFileDirectory)Grandia.Sdk.dll</GrandiaSdkDll>
    <GrandiaSdkDll Condition="'$(GrandiaSdkDll)' == '' and Exists('$(MSBuildThisFileDirectory)bin\Release\net8.0\Grandia.Sdk.dll')">$(MSBuildThisFileDirectory)bin\Release\net8.0\Grandia.Sdk.dll</GrandiaSdkDll>
    <GrandiaFieldPatch Condition="'$(GrandiaFieldPatch)' == '' and Exists('$(MSBuildThisFileDirectory)..\CMakeLists.txt')">$(MSBuildThisFileDirectory)..</GrandiaFieldPatch>
    <GrandiaFieldPatch Condition="'$(GrandiaFieldPatch)' == ''">$(MSBuildThisFileDirectory)</GrandiaFieldPatch>
    <FieldToolsExe Condition="'$(FieldToolsExe)' == '' and Exists('$(GrandiaModloaderDir)\field_tools\field_tools.exe')">$(GrandiaModloaderDir)\field_tools\field_tools.exe</FieldToolsExe>
    <FieldToolsExe Condition="'$(FieldToolsExe)' == '' and Exists('$(MSBuildThisFileDirectory)field_tools\field_tools.exe')">$(MSBuildThisFileDirectory)field_tools\field_tools.exe</FieldToolsExe>
    <FieldToolsExe Condition="'$(FieldToolsExe)' == '' and Exists('$(GrandiaFieldPatch)\vendor\field_tools\field_tools.exe')">$(GrandiaFieldPatch)\vendor\field_tools\field_tools.exe</FieldToolsExe>
    <AssembleModScripts Condition="'$(AssembleModScripts)' == ''">true</AssembleModScripts>
    <CopyModToLoader Condition="'$(CopyModToLoader)' == ''">true</CopyModToLoader>
    <CopyModDependencies Condition="'$(CopyModDependencies)' == ''">true</CopyModDependencies>
    <GrandiaModsDir Condition="'$(GrandiaModsDir)' == ''">$(APPDATA)\GrandiaModloader\mods</GrandiaModsDir>
  </PropertyGroup>

  <ItemGroup>
    <ScriptAsm Include="scripts\**\*.asm" />
    <None Include="scripts\**\*.asm" />
    <None Remove="scripts\**\*.bin" />
    <EmbeddedResource Include="scripts\**\*.bin">
      <LogicalName>scripts/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\**\*">
      <LogicalName>assets/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="AssembleEmbeddedScripts"
          BeforeTargets="PrepareResourceNames;BeforeCompile"
          Condition="'$(AssembleModScripts)' == 'true' and '@(ScriptAsm)' != ''">
    <PropertyGroup>
      <_ModScriptBinDir>$(MSBuildProjectDirectory)\scripts</_ModScriptBinDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(FieldToolsExe)')"
           Text="field_tools.exe not found. Run python tools\build_field_tools.py in GrandiaFieldPatch." />
    <Message Importance="high" Text="Assembling @(ScriptAsm->Count()) field script(s) into $(_ModScriptBinDir)" />
    <MakeDir Directories="$(_ModScriptBinDir)" />
    <Exec Command="&quot;$(FieldToolsExe)&quot; embed --in &quot;$(MSBuildProjectDirectory)\scripts&quot; --out &quot;$(_ModScriptBinDir)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <EmbeddedResource Include="$(_ModScriptBinDir)\*.bin">
        <LogicalName>scripts/%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CopyModToLoader" AfterTargets="Build"
          Condition="'$(CopyModToLoader)' == 'true' and '$(TargetPath)' != ''">
    <ItemGroup>
      <_ModCopyLocal Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' != 'Grandia.Sdk'" />
    </ItemGroup>
    <MakeDir Directories="$(GrandiaModsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GrandiaModsDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(GrandiaModsDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="@(_ModCopyLocal)" DestinationFolder="$(GrandiaModsDir)" SkipUnchangedFiles="true"
          Condition="'$(CopyModDependencies)' == 'true' and '@(_ModCopyLocal)' != ''" />
  </Target>
</Project>
