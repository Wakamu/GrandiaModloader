<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x86</InstallerPlatform>
    <OutputName>GrandiaModloaderSetup</OutputName>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <AppOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net8.0-windows\'))</AppOutDir>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
    <!-- MSI version is Major.Minor.Build (max 255.255.65535). 1.{yy}.{dayOfYear*100+hour}
         is unique per hour so a rebuild upgrades instead of Repair. -->
    <MsiVersion>1.$([System.DateTime]::UtcNow.ToString('yy')).$([MSBuild]::Add($([MSBuild]::Multiply($([System.DateTime]::UtcNow.DayOfYear), 100)), $([System.DateTime]::UtcNow.Hour)))</MsiVersion>
    <DefineConstants>$(DefineConstants);MsiVersion=$(MsiVersion)</DefineConstants>
    <!-- ICE61 complains because AllowSameVersionUpgrades sets MaxVersion = this Version. -->
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrandiaModloader.csproj" />
    <BindPath Include="$(AppOutDir)" BindName="app" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="StageNativePayload" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(AppOutDir)" />
    <ItemGroup>
      <_StageFile Include="$(RepoRoot)dist\GrandiaMod.dll" Condition="Exists('$(RepoRoot)dist\GrandiaMod.dll')" />
      <_StageFile Include="$(RepoRoot)build\Release\GrandiaMod.dll" Condition="Exists('$(RepoRoot)build\Release\GrandiaMod.dll')" />
      <_StageFile Include="$(RepoRoot)dist\Grandia.Runtime.dll" Condition="Exists('$(RepoRoot)dist\Grandia.Runtime.dll')" />
      <_StageFile Include="$(RepoRoot)dist\Grandia.Runtime.runtimeconfig.json" Condition="Exists('$(RepoRoot)dist\Grandia.Runtime.runtimeconfig.json')" />
      <_StageFile Include="$(RepoRoot)dist\Grandia.Runtime.deps.json" Condition="Exists('$(RepoRoot)dist\Grandia.Runtime.deps.json')" />
      <_StageFile Include="$(RepoRoot)dist\Grandia.Sdk.dll" Condition="Exists('$(RepoRoot)dist\Grandia.Sdk.dll')" />
      <_StageFile Include="$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Runtime.dll" Condition="Exists('$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Runtime.dll')" />
      <_StageFile Include="$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Runtime.runtimeconfig.json" Condition="Exists('$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Runtime.runtimeconfig.json')" />
      <_StageFile Include="$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Runtime.deps.json" Condition="Exists('$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Runtime.deps.json')" />
      <_StageFile Include="$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Sdk.dll" Condition="Exists('$(RepoRoot)runtime\bin\$(Configuration)\net8.0\Grandia.Sdk.dll')" />
      <_StageFile Include="$(RepoRoot)sdk\bin\$(Configuration)\net8.0\Grandia.Sdk.dll" Condition="Exists('$(RepoRoot)sdk\bin\$(Configuration)\net8.0\Grandia.Sdk.dll')" />
      <_StageFile Include="$(RepoRoot)sdk\Grandia.Mod.targets" Condition="Exists('$(RepoRoot)sdk\Grandia.Mod.targets')" />
      <_StageFile Include="$(RepoRoot)data\pdat_charpack.bin" Condition="Exists('$(RepoRoot)data\pdat_charpack.bin')" />
    </ItemGroup>
    <Copy SourceFiles="@(_StageFile)" DestinationFolder="$(AppOutDir)" SkipUnchangedFiles="true"
          Condition="'@(_StageFile)' != ''" />
    <ItemGroup>
      <_TemplateFile Include="$(RepoRoot)templates\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TemplateFile)"
          DestinationFiles="@(_TemplateFile->'$(AppOutDir)templates\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_TemplateFile)' != ''" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\app.ico"
          DestinationFiles="$(AppOutDir)templates\GrandiaMod\__TemplateIcon.ico"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\app.ico')" />
  </Target>

  <!-- Same payload as the MSI, as dist\GrandiaModloader-win-x86.zip for the in-app updater.
       Attach that file to the GitHub release (keep the name). -->
  <Target Name="PackUpdateZip" AfterTargets="Build">
    <PropertyGroup>
      <_UpdateZipStage>$(RepoRoot)build\update-zip</_UpdateZipStage>
      <_UpdateZipPath>$(RepoRoot)dist\GrandiaModloader-win-x86.zip</_UpdateZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(_UpdateZipStage)" Condition="Exists('$(_UpdateZipStage)')" />
    <MakeDir Directories="$(_UpdateZipStage);$(RepoRoot)dist" />
    <ItemGroup>
      <_ZipFile Include="$(AppOutDir)**\*"
                Exclude="$(AppOutDir)**\*.pdb;$(AppOutDir)mods\**\*;$(AppOutDir)templates\**\obj\**;$(AppOutDir)templates\**\bin\**;$(AppOutDir)config.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZipFile)"
          DestinationFiles="@(_ZipFile->'$(_UpdateZipStage)\%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'@(_ZipFile)' != ''" />
    <Delete Files="$(_UpdateZipPath)" Condition="Exists('$(_UpdateZipPath)')" />
    <ZipDirectory SourceDirectory="$(_UpdateZipStage)" DestinationFile="$(_UpdateZipPath)"
                  Overwrite="true" />
    <Message Text="Update zip: $(_UpdateZipPath)" Importance="high" />
  </Target>
</Project>
